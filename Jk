local function Notify(t,c,d) R:Notify({Title=t,Content=c,Duration=d or 3,Image=4483362458,Actions={Ignore={Name="ตกลง",Callback=function()end}}}) end
local function TeleportTo(cf) if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then LP.Character.HumanoidRootPart.CFrame=cf Notify("ระบบวาร์ป","ย้ายตำแหน่งเรียบร้อยแล้ว!",2) else Notify("แจ้งเตือน","ไม่พบตัวละครของคุณในขณะนี้",3) end end

LP.Idled:Connect(function() if AntiAFK then VU:Button2Down(Vector2.zero,Cam.CFrame) task.wait(1) VU:Button2Up(Vector2.zero,Cam.CFrame) end end)
UIS.JumpRequest:Connect(function() if MT and InfJ and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end end)
RS.Stepped:Connect(function() if MT and Noc and LP.Character then for _,v in pairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") and v.CanCollide then v.CanCollide=false end end end end)

RS.RenderStepped:Connect(function()
    if not MT then if BGI then BGI:Destroy() BGI=nil end if BVI then BVI:Destroy() BVI=nil end return end
    if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then local h=LP.Character:FindFirstChildOfClass("Humanoid") h.WalkSpeed=WSV h.UseJumpPower=true h.JumpPower=JPV end
    if FB then L.Ambient=Color3.fromRGB(255,255,255) L.Brightness=2 L.ClockTime=14 end
    for _,p in pairs(P:GetPlayers()) do
        if p~=LP and p.Character then
            local c,hl,bb=p.Character,p.Character:FindFirstChild("MinHub_ESP_Highlight"),p.Character:FindFirstChild("MinHub_ESP_Billboard")
            if ESP then
                if not hl then hl=Instance.new("Highlight",c) hl.Name="MinHub_ESP_Highlight" hl.OutlineColor=Color3.fromRGB(255,255,255) hl.FillTransparency=0.4 else hl.FillColor=ESPC end
                if (ESPN or ESPD) and c:FindFirstChild("Head") then
                    if not bb then
                        bb=Instance.new("BillboardGui",c) bb.Name="MinHub_ESP_Billboard" bb.Adornee=c.Head bb.Size=UDim2.new(0,200,0,50) bb.StudsOffset=Vector3.new(0,3,0) bb.AlwaysOnTop=true
                        local l=Instance.new("TextLabel",bb) l.Name="InfoLabel" l.Size=UDim2.new(1,0,1,0) l.BackgroundTransparency=1 l.TextColor3=Color3.fromRGB(255,255,255) l.Font=Enum.Font.SourceSansBold l.TextSize=14
                    end
                    local lbl=bb:FindFirstChild("InfoLabel")
                    if lbl then
                        local txt=""
                        if ESPN then txt=txt..p.Name end
                        if ESPD and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                            txt=txt..(ESPN and " | " or "")..math.floor((c.Head.Position-LP.Character.HumanoidRootPart.Position).Magnitude).."m"
                        end
                        lbl.Text=txt
                    end
                elseif bb then bb:Destroy() end
            else if hl then hl:Destroy() end if bb then bb:Destroy() end end
        end
    end
    if Fly and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp,hum=LP.Character.HumanoidRootPart,LP.Character:FindFirstChildOfClass("Humanoid")
        if not BGI or not BVI or not BGI.Parent then
            if BGI then BGI:Destroy() end if BVI then BVI:Destroy() end
            BGI=Instance.new("BodyGyro",hrp) BGI.P=9e4 BGI.maxTorque=Vector3.new(9e9,9e9,9e9)
            BVI=Instance.new("BodyVelocity",hrp) BVI.maxForce=Vector3.new(9e9,9e9,9e9)
        end
        if hum then hum.PlatformStand=true end BGI.CFrame=Cam.CFrame
        local dir=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir+=Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir-=Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir-=Vector3.new(0,1,0) end
        BVI.Velocity=dir.Magnitude>0 and dir.Unit*FS or Vector3.zero
    else
        if BGI then BGI:Destroy() BGI=nil end if BVI then BVI:Destroy() BVI=nil end
        if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then LP.Character:FindFirstChildOfClass("Humanoid").PlatformStand=false end
    end
end)

task.spawn(function()
    while task.wait(FD) do
        if MT then
            if AP then pcall(function() local r=RSig:FindFirstChild("Plant",true) or RSig:FindFirstChild("PlantSeed",true) if r then r:FireServer(Seed) else local t=LP.Backpack:FindFirstChildOfClass("Tool") or (LP.Character and LP.Character:FindFirstChildOfClass("Tool")) if t then t:Activate() end end end) end
            if AC then pcall(function() local r=RSig:FindFirstChild("Harvest",true) or RSig:FindFirstChild("Collect",true) if r then r:FireServer() else for _,p in pairs(WS:GetDescendants()) do if p:IsA("ProximityPrompt") and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (p.Parent:GetPivot().Position-LP.Character.HumanoidRootPart.Position).Magnitude<18 then fireproximityprompt(p) end end end end) end
            if AB then pcall(function() local r=RSig:FindFirstChild("BuyItem",true) or RSig:FindFirstChild("BuySeed",true) if r then r:FireServer(Seed,1) end end) end
            if AS then pcall(function() local r=RSig:FindFirstChild("SellAll",true) or RSig:FindFirstChild("Sell",true) if r then r:FireServer() end end) end
        end
    end
end)

